{
  "type": "panel",
  "items": {
    "host": { "type": "text", "label": "EcoFlow IP-Adresse", "newLine": true },
    "port": { "type": "number", "label": "Modbus TCP Port", "default": 502 },
    "unitId": { "type": "number", "label": "Modbus Unit-ID", "default": 1 },
    "addressOffset": { "type": "number", "label": "Adressoffset", "default": 40001 },
    "pollInterval": { "type": "number", "label": "Polling-Intervall (Sekunden)", "default": 5 },
    "enableControlWrites": { "type": "checkbox", "label": "Control-Schreibzugriffe aktivieren (experimentell; nur nach bestätigter Registerzuordnung)", "default": false }
  }
}
